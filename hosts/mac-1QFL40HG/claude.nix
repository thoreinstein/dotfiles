{ pkgs, ... }:
{
  # Personal Claude Code setup. The nixpkgs package disables Claude's own auto-updater;
  # update it with `make update`. CLAUDE.md is shared via modules/home/claude.nix.
  programs.claude-code = {
    enable = true;
    package = pkgs.claude-code;

    # Merge into a writable settings.json so /config, permission prompts and plugin
    # installs keep working. Keys not declared here (env, autoMode) stay local-only.
    mutableSettings = true;

    settings = {
      effortLevel = "high";
      theme = "auto";
      tui = "fullscreen";
      enableWorkflows = false;
      workflowKeywordTriggerEnabled = false;
      useAutoModeDuringPlan = false;

      # Generated by claude-hud's setup; runs the newest cached claude-hud build.
      statusLine = {
        type = "command";
        command = ''bash -c 'cols=$(stty size </dev/tty 2>/dev/null | awk '"'"'{print $2}'"'"'); export COLUMNS=$(( ''${cols:-120} > 4 ? ''${cols:-120} - 4 : 1 )); plugin_dir=$(ls -d "''${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '"'"'{ print $(NF-1) "\t" $0 }'"'"' | grep -E '"'"'^[0-9]+\.[0-9]+\.[0-9]+[[:space:]]'"'"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec "${pkgs.nodejs}/bin/node" "''${plugin_dir}dist/index.js"'' + "'";
      };

      permissions = {
        defaultMode = "auto";
        allow = [
          "Bash(gh pr *)"
          "Bash(git status)"
          "Bash(git log *)"
          "Bash(git diff *)"
          "Bash(git branch *)"
          "Bash(ls *)"
          "Bash(find *)"
          "Bash(grep *)"
          "Bash(cat *)"
          "Bash(rtk *)"
          "mcp__codegraph__*"
          "mcp__obsidian-mcp__obsidian_read_note"
          "mcp__obsidian-mcp__obsidian_search_notes"
          "mcp__obsidian-mcp__obsidian_rag_query"
          "mcp__obsidian-mcp__obsidian_get_links"
          "mcp__obsidian-mcp__obsidian_list_notes"
          "mcp__plugin_engram_engram__mem_search"
          "mcp__plugin_engram_engram__mem_context"
          "mcp__plugin_engram_engram__mem_get_observation"
          "mcp__plugin_engram_engram__mem_save"
          "mcp__plugin_engram_engram__mem_update"
          "mcp__plugin_engram_engram__mem_session_summary"
          "mcp__plugin_engram_engram__mem_session_start"
          "mcp__plugin_engram_engram__mem_session_end"
          "mcp__plugin_engram_engram__mem_stats"
          "mcp__fetch__*"
          "mcp__sequential-thinking__sequentialthinking"
          "mcp__exa__*"
          "mcp__jira__*"
          "mcp__glean__*"
          "mcp__firehydrant__*"
          "mcp__plugin_aic-ai_firehydrant__*"
          "mcp__engram__*"
          "mcp__plugin_engram_engram__*"
          "mcp__plugin_github_github__*"
          "mcp__obsidian-mcp__*"
        ];
      };

      hooks = {
        # Lets `agent-resume` pick this session back up after a reboot.
        SessionStart = [{ hooks = [{ type = "command"; command = ''agent-resume record claude "$(${pkgs.jq}/bin/jq -r .session_id)" "$PWD"''; }]; }];
        UserPromptSubmit = [{ hooks = [{ type = "command"; command = "codegraph prompt-hook"; }]; }];
        PreToolUse = [{ matcher = "Bash"; hooks = [{ type = "command"; command = "rtk hook claude"; }]; }];
        # Points code searches in a CodeGraph-indexed repo at codegraph_explore; never blocks.
        PostToolUse = [{ matcher = "Grep|Glob|Bash"; hooks = [{ type = "command"; command = "codegraph-nudge"; }]; }];
        PreCompact = [{
          hooks = [{
            type = "agent";
            prompt = "Conversation about to be compacted. Save current working context to Engram before it's lost. Steps: 1) Call mem_session_summary with current goal, what's been discovered/accomplished, what's in progress, and next steps. 2) Call mem_save for any decisions, bugfixes, or patterns found this session that haven't been saved yet. Be specific — future sessions need enough context to resume without asking what was happening.";
            timeout = 45;
          }];
        }];
      };

      enabledPlugins = {
        "context7@claude-plugins-official" = true;
        "feature-dev@claude-plugins-official" = true;
        "github@claude-plugins-official" = true;
        "gopls-lsp@claude-plugins-official" = true;
        "playwright@claude-plugins-official" = true;
        "pr-review-toolkit@claude-plugins-official" = true;
        "security-guidance@claude-plugins-official" = true;
        "skill-creator@claude-plugins-official" = true;
        "superpowers@claude-plugins-official" = true;
        "typescript-lsp@claude-plugins-official" = true;
        "obsidian-rag@thoreinstein-plugins" = false;
        "claude-md-management@claude-plugins-official" = true;
        "engram@engram" = true;
        "claude-notifications-go@claude-notifications-go" = true;
        "claude-hud@claude-hud" = true;
        "aic-ai@aic-ai" = true;
        "polaris@polaris" = true;
        "caveman@caveman" = true;
      };

      # Work marketplaces (aic-ai, polaris) point at private repos; they live only in the
      # local settings.json, which mutableSettings leaves alone.
      extraKnownMarketplaces = {
        thoreinstein-plugins.source = { source = "git"; url = "git@github.com:thoreinstein/claude-plugins.git"; };
        engram.source = { source = "github"; repo = "Gentleman-Programming/engram"; };
        claude-notifications-go.source = { source = "github"; repo = "777genius/claude-notifications-go"; };
        claude-hud.source = { source = "github"; repo = "jarrodwatts/claude-hud"; };
        caveman.source = { source = "github"; repo = "JuliusBrussee/caveman"; };
      };
    };

    commands = {
      brain-dump = ./claude/commands/brain-dump.md;
      synthesize = ./claude/commands/synthesize.md;
    };

    # Shared with pi, which installs the same files from modules/home/pi/default.nix.
    skills = {
      compound = ../../modules/home/pi/skills/compound/SKILL.md;
      plan-review = ../../modules/home/pi/skills/plan-review/SKILL.md;
      rebase = ../../modules/home/pi/skills/rebase/SKILL.md;
      standup = ../../modules/home/pi/skills/standup/SKILL.md;
    };
  };

  home.file.".claude/keybindings.json".source = ./claude/keybindings.json;
}
