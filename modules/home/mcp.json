{
  "mcpServers": {
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@0.0.67"
      ]
    },
    "gcp-gke": {
      "type": "http",
      "url": "https://container.googleapis.com/mcp"
    },
    "gcp-logging": {
      "type": "http",
      "url": "https://logging.googleapis.com/mcp"
    },
    "gcp-monitoring": {
      "type": "http",
      "url": "https://monitoring.googleapis.com/mcp"
    },
    "gcp-firestore": {
      "type": "http",
      "url": "https://firestore.googleapis.com/mcp"
    },
    "exa": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server@3.4.2"
      ],
      "env": {
        "EXA_API_KEY": "$EXA_API_KEY"
      }
    },
    "jira": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "glean": {
      "type": "http",
      "url": "https://pingidentity-be.glean.com/mcp/default"
    },
    "firehydrant": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec npx -y firehydrant-mcp@0.0.4 start --transport stdio --api-key \"$FIREHYDRANT_API_KEY\""
      ]
    },
    "obsidian-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "github:thoreinstein/obsidian-mcp#a948996"
      ]
    },
    "gcp-devknowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp"
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "ynab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "ynab-mcp-server@0.4.1"
      ],
      "env": {
        "YNAB_API_TOKEN": "${YNAB_TOKEN}"
      }
    }
  }
}
