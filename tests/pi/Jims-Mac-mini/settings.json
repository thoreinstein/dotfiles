    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-plan-mode",
    "npm:@narumitw/pi-starship",
    "npm:context-mode",
    "npm:gentle-engram@0.1.8",
    "npm:pi-bash-live-view",
    "npm:pi-caveman",
